{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node kit.js hook session-start",
        "bash": "node kit.js hook session-start",
        "powershell": "node kit.js hook session-start",
        "timeoutSec": 20
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node kit.js hook protect-main",
        "bash": "node kit.js hook protect-main",
        "powershell": "node kit.js hook protect-main",
        "timeoutSec": 20
      },
      {
        "type": "command",
        "command": "node kit.js hook commit-gate",
        "bash": "node kit.js hook commit-gate",
        "powershell": "node kit.js hook commit-gate",
        "timeoutSec": 600
      }
    ]
  }
}
